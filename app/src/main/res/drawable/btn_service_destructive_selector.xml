<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FF453A" />
            <stroke android:width="2dp" android:color="@color/status_stopped" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#55FF453A" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1FFF453A" />
            <stroke android:width="1dp" android:color="#66FF453A" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
