<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/nav_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/nav_panel_glass"
            android:elevation="4dp"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/nav_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/nav_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/nav_item_home"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:text="@string/nav_home"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:textColor="@color/nav_item_normal"
                    android:background="@drawable/nav_item_selector"
                    android:focusable="true"
                    android:nextFocusRight="@id/nav_item_settings" />

                <TextView
                    android:id="@+id/nav_item_settings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:text="@string/nav_settings"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:textColor="@color/nav_item_normal"
                    android:background="@drawable/nav_item_selector"
                    android:focusable="true"
                    android:nextFocusLeft="@id/nav_item_home"
                    android:nextFocusRight="@id/nav_item_devices" />

                <TextView
                    android:id="@+id/nav_item_devices"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:text="@string/nav_devices"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:textColor="@color/nav_item_normal"
                    android:background="@drawable/nav_item_selector"
                    android:focusable="true"
                    android:nextFocusLeft="@id/nav_item_settings"
                    android:nextFocusRight="@id/nav_item_now_playing" />

                <TextView
                    android:id="@+id/nav_item_now_playing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:text="@string/nav_now_playing"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:textColor="@color/nav_item_normal"
                    android:background="@drawable/nav_item_selector"
                    android:focusable="true"
                    android:nextFocusLeft="@id/nav_item_devices" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/nav_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.35"
            android:background="@color/divider" />

        <FrameLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/streaming_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
