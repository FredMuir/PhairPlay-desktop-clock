<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingTop="@dimen/page_top_padding"
        android:paddingEnd="@dimen/page_horizontal_padding"
        android:paddingBottom="@dimen/page_bottom_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_page_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/home_title_size"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/text_device_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/focus_ring_selector"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="9dp">
                    <View
                        android:id="@+id/dot_service_state"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/status_dot" />
                    <TextView
                        android:id="@+id/text_service_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/service_state_stopped"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_section_spacing"
            android:orientation="vertical"
            android:background="@drawable/focus_ring_selector"
            android:padding="@dimen/home_card_padding">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/speaker_section_title"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />

            <include
                android:id="@+id/card_airplay"
                layout="@layout/card_protocol_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
            <include
                android:id="@+id/card_miracast"
                layout="@layout/card_protocol_status"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <include
                android:id="@+id/card_cast"
                layout="@layout/card_protocol_status"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/speaker_room_hint"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_section_spacing"
            android:layout_marginBottom="9dp"
            android:text="@string/section_controls"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/action_start"
                android:textColor="@color/background_dark"
                android:textSize="16sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:background="@drawable/btn_service_primary_selector"
                android:focusable="true"
                android:nextFocusRight="@id/btn_stop" />
            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:text="@string/action_stop"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:background="@drawable/btn_service_destructive_selector"
                android:focusable="true"
                android:nextFocusLeft="@id/btn_start"
                android:nextFocusRight="@id/btn_restart" />
            <Button
                android:id="@+id/btn_restart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/action_restart"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:background="@drawable/btn_service_secondary_selector"
                android:focusable="true"
                android:nextFocusLeft="@id/btn_stop" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_card_spacing"
            android:orientation="vertical"
            android:background="@drawable/focus_ring_selector"
            android:padding="@dimen/home_secondary_card_padding">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/speaker_howto_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/speaker_howto_body"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
