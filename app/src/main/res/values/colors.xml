<resources>
    <color name="launcher_icon_background">#FF10272A</color>
    <!-- ─── Backgrounds ─────────────────────────────────────── -->
    <!-- True black — best for OLED, minimal visual noise on TV -->
    <color name="background_dark">#FF0C1115</color>
    <!-- Surface elevation: cards, sheets, nav panel -->
    <color name="background_surface">#FF151D22</color>
    <!-- Slightly lighter surface for hover/pressed states -->
    <color name="background_surface_elevated">#FF202B31</color>
    <!-- Dividers and separators -->
    <color name="divider">#FF263238</color>

    <!-- ─── Text ─────────────────────────────────────────────── -->
    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_secondary">#FF9AA9A8</color>
    <color name="text_tertiary">#FF636366</color>
    <color name="text_on_accent">#FFFFFFFF</color>

    <!-- ─── Accent (Google TV blue) ─────────────────────────── -->
    <color name="accent_blue">#FF62B5A1</color>
    <color name="accent_blue_pressed">#FF478C78</color>
    <color name="focus_ring">#FF62B5A1</color>

    <!-- ─── Protocol status colors ──────────────────────────── -->
    <!-- Green: service running / connected -->
    <color name="status_running">#FF34C759</color>
